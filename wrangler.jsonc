{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facil",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: exigido pelo toolchain de testes (@cloudflare/vitest-plugin) e
  // por utilitarios internos do wrangler. Nao e usado para logica de negocio.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Qualquer rota /api/* vai direto ao Worker (nao cai no fallback de SPA),
    // garantindo que 404 de API retorne JSON e nao HTML.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facil-db",
      // ID real do D1 criado em 19/10/2026 (conta Cloudflare do autor).
      "database_id": "10365b4d-7ed0-4e8e-8aba-65ebf354cb25",
      "migrations_dir": "migrations"
    }
  ],
  // Anexos do chat de suporte (F-19): o binario vive no R2 (free tier), os
  // metadados no D1. O R2 ainda NAO foi habilitado na conta de publicacao, e o
  // `wrangler deploy` recusa binding para bucket inexistente. Sem o binding a
  // API responde 503 com mensagem clara (apenas anexos do suporte; chamados/OS
  // usam o D1). Para ativar:
  //   1) habilite o R2 no painel da Cloudflare (exige dados de cobranca);
  //   2) `npx wrangler r2 bucket create facil-attachments`;
  //   3) descomente o bloco abaixo, rode `npm run types` e `npm run deploy`.
  // "r2_buckets": [
  //   {
  //     "binding": "ATTACHMENTS",
  //     "bucket_name": "facil-attachments"
  //   }
  // ],
  "observability": {
    "enabled": true
  },
  "previews": {}
}

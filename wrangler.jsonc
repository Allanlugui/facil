{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facil",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: exigido pelo toolchain de testes (@cloudflare/vitest-plugin) e
  // por utilitarios internos do wrangler. Nao e usado para logica de negocio.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Qualquer rota /api/* vai direto ao Worker (nao cai no fallback de SPA),
    // garantindo que 404 de API retorne JSON e nao HTML.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facil-db",
      // ID real do D1 criado em 19/10/2026 (conta Cloudflare do autor).
      "database_id": "10365b4d-7ed0-4e8e-8aba-65ebf354cb25",
      "migrations_dir": "migrations"
    }
  ],
  // Chat de suporte em tempo real: uma sala por solicitação. O D1 continua
  // sendo a fonte da verdade; o Durable Object só transmite eventos.
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPPORT_ROOM",
        "class_name": "SupportRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SupportRoom"]
    }
  ],
  // Anexos do chat de suporte (F-19): o binario vive no R2 (free tier), os
  // metadados no D1. Bucket `facil-attachments` criado e binding `ATTACHMENTS`
  // habilitado na release 0.7.1 (23/10/2026).
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "facil-attachments"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "previews": {}
}

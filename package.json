{
  "name": "facil",
  "version": "0.11.3",
  "private": true,
  "type": "module",
  "description": "Plataforma Unificada de Gestao de Facilities - estoque, consumo, inventario, manutencao, compras, permissoes e auditoria.",
  "author": "Allan Luiz Silveira Lima (Allanlugui)",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run check:api && npm run test",
    "check:api": "node scripts/check-api-paths.mjs",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sign": "node scripts/sign-release.mjs",
    "verify": "node scripts/verify-release.mjs",
    "release": "npm run sign && npm run check && npm run build",
    "deploy": "npm run release && wrangler deploy",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply facil-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply facil-db --remote",
    "db:reset": "wrangler d1 execute facil-db --local --file=./seeds/reset.sql",
    "seed": "wrangler d1 execute facil-db --local --file=./seeds/demo.sql"
  },
  "dependencies": {
    "hono": "^4.9.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
